# PingGuard Environment Variables — Chapter 3: Distributed Task Execution
# Asynchronous PostgreSQL connection string for FastAPI runtime (asyncpg)
# Alembic env.py and Celery sync engine will translate +asyncpg to +psycopg2.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pingguard

# Redis Message Broker & Result Backend for Celery
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1

# Celery Beat Periodic Sweep Frequency (seconds)
SWEEP_INTERVAL_SECONDS=15.0

# Chapter 5: Network Resilience & HTTPX Prober Settings
HTTP_CONNECT_TIMEOUT=2.0
HTTP_READ_TIMEOUT=5.0
HTTP_WRITE_TIMEOUT=5.0
HTTP_POOL_TIMEOUT=2.0
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=PingGuard-Monitor/0.5.0 (+https://github.com/pingguard/pingguard; uptime-engine)
HTTP_KEEP_ALIVE_USER_AGENT=PingGuard-KeepAlive/0.5.0 (+https://github.com/pingguard/pingguard; keep-alive-engine)

