# ==============================================================================
# PingGuard Environment Variables Template — Chapter 6: Container Orchestration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Credentials & Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pingguard

# --- For Docker Compose (Container-to-Container via Docker DNS) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/pingguard

# --- For Local Bare-Metal Development (Host-to-Localhost) ---
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pingguard

# ------------------------------------------------------------------------------
# 2. Redis Broker & Backend Configuration
# ------------------------------------------------------------------------------
# --- For Docker Compose (Container-to-Container via Docker DNS) ---
REDIS_BROKER_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND_URL=redis://redis:6379/1

# --- For Local Bare-Metal Development (Host-to-Localhost) ---
# REDIS_BROKER_URL=redis://localhost:6379/0
# REDIS_RESULT_BACKEND_URL=redis://localhost:6379/1

# ------------------------------------------------------------------------------
# 3. Celery Beat Periodic Sweep Frequency (seconds)
# ------------------------------------------------------------------------------
SWEEP_INTERVAL_SECONDS=15.0

# ------------------------------------------------------------------------------
# 4. Chapter 5: Network Resilience & HTTPX Prober Settings
# ------------------------------------------------------------------------------
HTTP_CONNECT_TIMEOUT=2.0
HTTP_READ_TIMEOUT=5.0
HTTP_WRITE_TIMEOUT=5.0
HTTP_POOL_TIMEOUT=2.0
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_REDIRECTS=5
HTTP_USER_AGENT=PingGuard-Monitor/0.6.0 (+https://github.com/AmanYdv77/pingguard; uptime-engine)
HTTP_KEEP_ALIVE_USER_AGENT=PingGuard-KeepAlive/0.6.0 (+https://github.com/AmanYdv77/pingguard; keep-alive-engine)
